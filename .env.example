# Shared access code both travelers enter on the gate screen — full access.
# Kept as a fallback sign-in path even once email magic-link (below) is set up.
TRIP_ACCESS_CODE=change-me

# Optional second code for friends: same app, read-only, and no trip documents
# (neither the Documents tab nor files attached to a place/city). Leave unset
# and there is no guest view at all. Guests never get real accounts — this
# code is the only way in for them, magic-link is owner-only.
TRIP_GUEST_CODE=

# Data backend: "memory" (placeholder data, no infra needed) | "supabase" (Phase 8)
DATA_BACKEND=memory

# --- Supabase backend (set DATA_BACKEND=supabase) ---
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   # the "secret" API key (Settings → API); server-only, bypasses RLS, never shipped to the browser
# (legacy projects: SUPABASE_SERVICE_KEY with the service_role JWT also works)

# --- Owner sign-in via Supabase Auth (email magic-link) ---
# Comma-separated allow-list: a signed-in email not on this list buys no role.
# TRIP_OWNER_EMAILS=yuval@example.com,luciana@example.com
#
# Needed regardless of DATA_BACKEND — Supabase Auth is a property of the
# Supabase project, not of which datastore is selected. SUPABASE_URL (above)
# is reused; the publishable key is safe to also expose to the frontend as
# VITE_SUPABASE_PUBLISHABLE_KEY (see src/lib/supabaseClient.ts).
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
