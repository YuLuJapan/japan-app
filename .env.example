# Shared access code both travelers enter on the gate screen — full access
TRIP_ACCESS_CODE=change-me

# Optional second code for friends: same app, read-only, and no trip documents
# (neither the Documents tab nor files attached to a place/city). Leave unset
# and there is no guest view at all.
TRIP_GUEST_CODE=

# Data backend: "memory" (placeholder data, no infra needed) | "supabase" (Phase 8)
DATA_BACKEND=memory

# --- Supabase backend (set DATA_BACKEND=supabase) ---
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   # the "secret" API key (Settings → API); server-only, bypasses RLS, never shipped to the browser
# (legacy projects: SUPABASE_SERVICE_KEY with the service_role JWT also works)

# --- Optional: English map labels ---
# Free MapTiler key (no credit card) for English street/place labels on the
# city maps. Sign up at https://cloud.maptiler.com/account/keys/. Unset =
# falls back to CARTO's tiles, which label streets in Japanese.
# VITE_MAPTILER_KEY=
